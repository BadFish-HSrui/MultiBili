target 'iosApp' do
  use_frameworks!
  platform :ios, '16.0'

  pod 'BoloNativePlayer', :path => '../nativePlayer/build/ios'
  pod 'composeApp', :path => '../composeApp'
end

post_install do |installer|
  native_target = installer.pods_project.targets.find { |target| target.name == 'BoloNativePlayer' }
  raise 'Missing BoloNativePlayer target in Pods project.' unless native_target

  copy_phase = native_target.shell_script_build_phases.find { |phase| phase.name == '[CP] Copy XCFrameworks' }
  raise 'Missing Copy XCFrameworks phase for BoloNativePlayer.' unless copy_phase

  phase_name = 'Prepare iOS native player'
  prepare_phase = native_target.shell_script_build_phases.find { |phase| phase.name == phase_name } ||
    native_target.new_shell_script_build_phase(phase_name)
  prepare_phase.shell_path = '/bin/sh'
  prepare_phase.shell_script = <<~'SCRIPT'
    set -eu
    unset SWIFT_DEBUG_INFORMATION_FORMAT SWIFT_DEBUG_INFORMATION_VERSION
    REPO_ROOT="$(CDPATH= cd -- "${PODS_TARGET_SRCROOT}/../../.." && pwd)"
    "${REPO_ROOT}/gradlew" -p "${REPO_ROOT}" :nativePlayer:prepareIosNative
  SCRIPT
  prepare_phase.always_out_of_date = '1'
  prepare_phase.show_env_vars_in_log = '0'
  prepare_phase.input_paths = ['$(PODS_TARGET_SRCROOT)/../../../gradlew']
  prepare_phase.output_paths = [
    '$(PODS_TARGET_SRCROOT)/BoloNativePlayer.xcframework',
    '$(PODS_TARGET_SRCROOT)/licenses',
  ]

  native_target.build_configurations.each do |configuration|
    configuration.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
  end
end

post_integrate do |installer|
  # CocoaPods 保存 Aggregate Target 时会排序，集成完成后再固定脚本顺序。
  native_target = installer.pods_project.targets.find { |target| target.name == 'BoloNativePlayer' }
  phases = native_target.build_phases
  prepare_phase = phases.find { |phase| phase.name == 'Prepare iOS native player' }
  copy_phase = phases.find { |phase| phase.name == '[CP] Copy XCFrameworks' }
  phases.delete(prepare_phase)
  phases.insert(phases.index(copy_phase), prepare_phase)
  installer.pods_project.save
end
